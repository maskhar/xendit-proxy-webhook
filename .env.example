# Non-secret deployment settings only. Copy to .env and do not commit .env.
# This example starts TEST mode. Use a separate deployment directory AND
# Compose project, domain, database, and full set of secret files for live mode.
# Changing project name alone reuses ./secrets/* and is not isolation.
COMPOSE_PROJECT_NAME=xendit-proxy-test
APP_ENV=test
GATEWAY_DOMAIN=xendit-test.example.com
XENDIT_BUSINESS_ID=replace-with-test-business-id
LOG_LEVEL=info

# Xendit provider origin is pinned by compose/app to https://api.xendit.co.
# ALLOW_INSECURE_XENDIT_BASE_URL must stay false outside isolated NODE_ENV=test
# fake-provider tests; never use it for Test Mode or Live deployment.

# Optional tuning (application defaults shown). Uncomment when needed.
# DATABASE_MAX_CONNECTIONS=20
# PROVIDER_TIMEOUT_MS=20000
# WEBHOOK_BODY_LIMIT_BYTES=1048576
# API_BODY_LIMIT_BYTES=262144
# DELIVERY_BATCH_SIZE=20
# DELIVERY_POLL_MS=1000
# DELIVERY_LEASE_MS=60000
# DELIVERY_TIMEOUT_MS=15000

# Secret file contract used by compose.yaml. Create each file locally with no
# trailing commentary. `secrets/` is excluded from Docker build context and git.
# Never put production values in this file.
#
# secrets/postgres_password
#   Strong PostgreSQL role password.
# secrets/database_url
#   postgres://xproxy:<same-url-encoded-password>@db:5432/xproxy
# secrets/xendit_api_key
#   Test-mode secret API key for APP_ENV=test; live key only in live stack.
# secrets/xendit_callback_token
#   Dashboard webhook verification token matching same Xendit environment.
# secrets/encryption_key
#   Base64-encoded 32-byte key, for example generated with:
#   openssl rand -base64 32
# secrets/admin_token
#   Independent high-entropy admin bearer token, for example generated with:
#   openssl rand -hex 32
#
# Optional callback-token rotation:
# XENDIT_PREVIOUS_CALLBACK_TOKEN_FILE=/run/secrets/xendit_previous_callback_token
# Also add matching compose secret mount before setting this variable.
