{
	admin off
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@allowed {
		path /v1/* /webhooks/*
	}
	handle @allowed {
		reverse_proxy api:3000 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		respond "not found" 404
	}
}
